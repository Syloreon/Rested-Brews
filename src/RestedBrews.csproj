<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>RestedBrews</AssemblyName>
    <Product>Rested Brews</Product>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RestedBrews</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Plugin DLL lands directly in bin\<Config> with no framework subfolder -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <!-- Quiet down warnings caused by referencing the game's net-framework assemblies -->
    <NoWarn>$(NoWarn);MSB3277;NU1701</NoWarn>

    <!--
      Path to the Valheim install. Override on the command line with
      `dotnet build -p:ValheimInstall=...` or via the VALHEIM_INSTALL env var.
    -->
    <ValheimInstall Condition="'$(ValheimInstall)' == ''">$(VALHEIM_INSTALL)</ValheimInstall>
    <ValheimInstall Condition="'$(ValheimInstall)' == ''">F:\SteamLibrary\steamapps\common\Valheim</ValheimInstall>
    <ManagedDir>$(ValheimInstall)\valheim_Data\Managed</ManagedDir>

    <!--
      Path to Jotunn.dll (compile-time only; the installed Jotunn mod provides it at runtime).
      Override with -p:JotunnDll=... or the JOTUNN_DLL env var.
    -->
    <JotunnDll Condition="'$(JotunnDll)' == ''">$(JOTUNN_DLL)</JotunnDll>
    <JotunnDll Condition="'$(JotunnDll)' == ''">$(APPDATA)\com.kesomannen.gale\valheim\profiles\Valheim 1.0\BepInEx\plugins\ValheimModding-Jotunn\Jotunn.dll</JotunnDll>

    <!--
      Optional: where to copy the built DLL after a build, e.g. a Gale profile's
      BepInEx\plugins\Syloreon-RestedBrews folder. Override with -p:DeployDir=...
      or env RESTEDBREWS_DEPLOY.
    -->
    <DeployDir Condition="'$(DeployDir)' == ''">$(RESTEDBREWS_DEPLOY)</DeployDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx + HarmonyX (compile-time only; the user's installed BepInEx provides these at runtime) -->
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
  </ItemGroup>

  <ItemGroup>
    <!-- Game + Unity + Jotunn assemblies referenced locally; never copied into the output. -->
    <Reference Include="assembly_valheim">
      <HintPath>$(ManagedDir)\assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ManagedDir)\assembly_utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Jotunn">
      <HintPath>$(JotunnDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Fail early with a clear message if the game or Jotunn assemblies can't be found. -->
  <Target Name="CheckValheimRefs" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(ManagedDir)\assembly_valheim.dll')"
           Text="Could not find assembly_valheim.dll under '$(ManagedDir)'. Set the Valheim path with -p:ValheimInstall=... or the VALHEIM_INSTALL environment variable." />
    <Error Condition="!Exists('$(JotunnDll)')"
           Text="Could not find Jotunn.dll at '$(JotunnDll)'. Set it with -p:JotunnDll=... or the JOTUNN_DLL environment variable." />
  </Target>

  <!-- Copy the plugin to the deploy folder after build, if one is configured. -->
  <Target Name="DeployPlugin" AfterTargets="Build" Condition="'$(DeployDir)' != ''">
    <MakeDir Directories="$(DeployDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployDir)" OverwriteReadOnlyFiles="true" />
    <Message Importance="high" Text="Deployed $(TargetFileName) -> $(DeployDir)" />
  </Target>

</Project>
